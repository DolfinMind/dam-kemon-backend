# STAGING — copy to .env.staging, fill in real values.
# Boot with: SPRING_PROFILES_ACTIVE=staging ./gradlew bootRun
# or set in your deploy: SPRING_PROFILES_ACTIVE=staging

# ───── Activate staging Spring profile ─────
SPRING_PROFILES_ACTIVE=staging

# ───── MongoDB Atlas (separate cluster from prod) ─────
# Recommend a separate free M0 cluster for staging so you can wipe
# without fear, and the prod cluster stays read-only-ish.
MONGODB_URI=mongodb+srv://USER:PASSWORD@staging.mongodb.net/damkemon_staging?retryWrites=true&w=majority

# ───── Networking ─────
CORS_ALLOWED_ORIGINS=https://staging.damkemon.com,http://localhost:5173
SERVER_PORT=8080

# ───── Admin endpoints lockdown (REQUIRED in staging) ─────
# Generate with: openssl rand -hex 24
ADMIN_API_KEY=REPLACE_WITH_32_CHAR_RANDOM_STRING

# ───── Indexer (lighter than prod) ─────
# Override the application-staging.yml defaults if needed.
INDEXER_MAX_PRODUCTS_PER_SHOP=100
INDEXER_MAX_URLS_PER_SHOP=200
INDEXER_PER_HOST_PARALLELISM=2
INDEXER_GLOBAL_PARALLELISM=16
INDEXER_PER_EXTRACT_TIMEOUT_MS=20000
INDEXER_SCHEDULED=true
# Different cron than prod so they don't race on shared shop IPs
INDEXER_CRON=0 30 3 * * *

# ───── Headless browser (off in staging unless you're debugging SPA shops) ─────
BROWSER_ENABLED=false
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=25000

# ───── Daily price-history snapshot ─────
PRICE_HISTORY_ENABLED=true
PRICE_HISTORY_CRON=0 0 4 * * *

# ───── HTTP scraper tuning ─────
SCRAPER_TIMEOUT_MS=15000
SCRAPER_RETRIES=2
SCRAPER_RETRY_DELAY=800
SCRAPER_REQUEST_DELAY=500
