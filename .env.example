# Copy to .env and fill in real values. .env is gitignored.
# Spring Boot reads these automatically via `spring.config.import`.

# ───── MongoDB Atlas (REQUIRED) ─────
# Sign up at https://www.mongodb.com/cloud/atlas/register — free M0 tier (512MB).
#   1. Create a Cluster (free shared M0)
#   2. Database Access → add a user/password
#   3. Network Access → "Allow access from anywhere" (0.0.0.0/0) for dev
#   4. Cluster → "Connect" → "Drivers" → copy the URI; replace <password> + add /damkemon db name
# Example:
# MONGODB_URI=mongodb+srv://damkemon:YOUR_PASSWORD@cluster0.abc123.mongodb.net/damkemon?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/damkemon?retryWrites=true&w=majority

# ───── Networking ─────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
SERVER_PORT=8080

# ───── Admin endpoints lockdown ─────
# Leave blank for local dev (admin endpoints stay open with a WARN log).
# In staging/prod set to a 32+ char random string. The endpoints also accept
# an admin-role JWT (from POST /api/auth/login), so this is the fallback for
# curl-based scripts.
#   openssl rand -hex 24
ADMIN_API_KEY=

# ───── Owner (fixed-credential) sign-in ─────
# The owner signs in via POST /api/auth/login with this username + password.
# The password is BCrypt-hashed at boot before anything reaches Mongo;
# the literal never lands on disk.
OWNER_USERNAME=ssm@2026
OWNER_PASSWORD=$Sm7406.2025
# Optional — defaults to "<username>@owner.local" so we have an email field.
OWNER_EMAIL=

# ───── JWT session signing ─────
# 32+ char random string — HMAC-SHA256 secret. MUST be set in prod.
#   openssl rand -hex 32
AUTH_JWT_SECRET=
AUTH_JWT_TTL_DAYS=30

# ───── Atlas Search (optional) ─────
# Uses Mongo Atlas's built-in $search aggregation. Requires you to create an
# Atlas Search index named below on the products collection. Off by default;
# code transparently falls back to the $text path when disabled or unavailable.
SEARCH_ATLAS_ENABLED=false
SEARCH_ATLAS_INDEX=default

# ───── Nightly catalog indexer ─────
# Cron expression for the full reindex. Default 03:00 local time.
INDEXER_CRON=0 0 3 * * *
# Set false to disable the nightly auto-run (manual triggers via
# POST /api/admin/index/run still work).
INDEXER_SCHEDULED=true
# Per-shop caps to bound nightly cost. Tune up once you have a sense
# of how your shops behave.
INDEXER_MAX_URLS_PER_SHOP=1500
INDEXER_MAX_PRODUCTS_PER_SHOP=500
INDEXER_PER_HOST_PARALLELISM=2
INDEXER_GLOBAL_PARALLELISM=24
INDEXER_PER_EXTRACT_TIMEOUT_MS=15000

# ───── Scraper HTTP tuning (per-request behaviour) ─────
SCRAPER_TIMEOUT_MS=15000
SCRAPER_RETRIES=2
SCRAPER_RETRY_DELAY=800
SCRAPER_REQUEST_DELAY=600

# ───── Headless browser (Playwright + Chromium) ─────
# Disabled by default. Enable for JS-rendered shops (Daraz, Chaldal).
# First boot downloads Chromium (~150MB).
BROWSER_ENABLED=false
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=25000
BROWSER_WAIT_UNTIL=DOMCONTENTLOADED

# ───── Daily price-history snapshot ─────
PRICE_HISTORY_ENABLED=true
PRICE_HISTORY_CRON=0 0 4 * * *

# ───── Hot-drops rebuild ─────
HOT_DROPS_CRON=0 0 5 * * *

# ───── Per-IP rate limit on /api/search* ─────
# Token bucket: capacity tokens, refilled at refill-per-sec tokens/sec.
# Defaults ≈ 60 req/min sustained per IP with brief bursts to 60.
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PER_SEC=1.0

# ───── Reusable Lemon Squeezy payment module (off by default) ─────
PAYMENTS_ENABLED=false
PAYMENTS_FINGERPRINT_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARS
LEMON_SQUEEZY_TEST_API_KEY=REPLACE_WITH_TEST_MODE_API_KEY
LEMON_SQUEEZY_LIVE_API_KEY=
LEMON_SQUEEZY_WEBHOOK_SECRET=REPLACE_WITH_32_TO_40_RANDOM_CHARS
LEMON_SQUEEZY_WEBHOOK_URL=https://damkemon.com/api/payments/v1/webhooks/lemon-squeezy
PAYMENTS_REWIRE_ENABLED=false
PAYMENTS_REWIRE_STORE_ID=445309
PAYMENTS_REWIRE_PRODUCT_ID=1266751
PAYMENTS_REWIRE_VARIANT_ID=1980706
PAYMENTS_REWIRE_TEST_MODE=true
PAYMENTS_REWIRE_REDIRECT_URL=
RATE_LIMIT_PAYMENT_CAPACITY=20
RATE_LIMIT_PAYMENT_REFILL_PER_SEC=0.20
