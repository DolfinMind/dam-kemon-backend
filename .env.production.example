# PRODUCTION — copy to .env.production, fill in real values.
# Boot with: SPRING_PROFILES_ACTIVE=production java -jar dam-kemon-backend.jar
# or in Docker/k8s: set SPRING_PROFILES_ACTIVE=production in the deployment env.
#
# Never commit the populated .env.production. Use a secrets manager
# (AWS Secrets Manager, GCP Secret Manager, Vault) for MONGODB_URI in prod.

# ───── Activate production Spring profile ─────
SPRING_PROFILES_ACTIVE=production

# ───── MongoDB Atlas (paid tier recommended) ─────
# For real traffic, use at least M10 ($57/mo). M0 free is OK for early launch
# but caps at 512MB and has no backups. The URI format is the same.
MONGODB_URI=mongodb+srv://USER:PASSWORD@prod.mongodb.net/damkemon?retryWrites=true&w=majority&readPreference=secondaryPreferred&maxPoolSize=100

# ───── Networking ─────
CORS_ALLOWED_ORIGINS=https://damkemon.com,https://www.damkemon.com
SERVER_PORT=8080

# ───── Indexer (full-throttle) ─────
INDEXER_MAX_PRODUCTS_PER_SHOP=500
INDEXER_MAX_URLS_PER_SHOP=1500
INDEXER_PER_HOST_PARALLELISM=3
INDEXER_GLOBAL_PARALLELISM=64
INDEXER_PER_EXTRACT_TIMEOUT_MS=30000
INDEXER_SCHEDULED=true
INDEXER_CRON=0 0 3 * * *
# Polite UA that identifies the bot (some shops whitelist named bots)
INDEXER_USER_AGENT=Mozilla/5.0 (compatible; DamKemonBot/1.0; +https://damkemon.com/bot)

# ───── Headless browser (required in prod for SPA shops) ─────
# First boot downloads Chromium (~150MB). Provision +500MB ephemeral disk.
BROWSER_ENABLED=true
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=25000
BROWSER_WAIT_UNTIL=DOMCONTENTLOADED

# ───── Daily price-history snapshot ─────
PRICE_HISTORY_ENABLED=true
# Run AFTER the indexer so price snapshots reflect the just-refreshed catalog
PRICE_HISTORY_CRON=0 0 4 * * *

# ───── HTTP scraper tuning ─────
SCRAPER_TIMEOUT_MS=20000
SCRAPER_RETRIES=2
SCRAPER_RETRY_DELAY=1000
SCRAPER_REQUEST_DELAY=400

# ───── Recommended: hook up to APM / log aggregation ─────
# JAVA_TOOL_OPTIONS="-Dotel.service.name=dam-kemon -Dotel.exporter.otlp.endpoint=https://your-collector"
