# PRODUCTION — copy to .env.production, fill in real values.
# Boot with: SPRING_PROFILES_ACTIVE=production java -jar dam-kemon-backend.jar
# or in Docker/k8s: set SPRING_PROFILES_ACTIVE=production in the deployment env.
#
# Never commit the populated .env.production. Use a secrets manager
# (AWS Secrets Manager, GCP Secret Manager, Vault) for MONGODB_URI in prod.

# ───── Activate production Spring profile ─────
SPRING_PROFILES_ACTIVE=production
SERVER_PORT=8080

# ───── MongoDB Atlas ─────
# For real traffic, use at least M10 ($57/mo). M0 free is OK for early launch
# but caps at 512MB and has no backups. The URI format is the same.
MONGODB_URI=mongodb+srv://USER:PASSWORD@prod.mongodb.net/damkemon?retryWrites=true&w=majority&readPreference=secondaryPreferred&maxPoolSize=100

# ───── Networking ─────
# Replace with your real domain(s). Commas separate. No trailing slash.
CORS_ALLOWED_ORIGINS=https://damkemon.com,https://www.damkemon.com

# ───── Admin endpoint static key (fallback to JWT) ─────
#   openssl rand -hex 24
ADMIN_API_KEY=REPLACE_WITH_RANDOM_48_HEX_CHARS

# ───── Owner sign-in ─────
OWNER_USERNAME=REPLACE_WITH_OWNER_USERNAME
OWNER_PASSWORD=REPLACE_WITH_12_PLUS_CHARACTER_OWNER_PASSWORD
OWNER_EMAIL=owner@example.com

# ───── JWT session signing ─────
#   openssl rand -hex 32
AUTH_JWT_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARS
AUTH_JWT_TTL_DAYS=30

# ───── Transactional mail + sign-in ─────
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
RESEND_FROM_EMAIL=alerts@example.com
RESEND_FROM_NAME=Damkemon
GOOGLE_CLIENT_ID=OPTIONAL_GOOGLE_OAUTH_CLIENT_ID

# ───── Analytics quality ─────
ANALYTICS_STORE_RAW_IP=false
ANALYTICS_CLEAN_TRAFFIC_ENABLED=true

# ───── Price alerts ─────
# Keep disabled until staging confirms fresh catalog data and email delivery.
PRICE_ALERTS_ENABLED=false
PRICE_ALERTS_MAX_AGE_HOURS=30
PRICE_ALERTS_CRON=0 30 * * * *

# ───── Atlas Search (turn on once the index exists in Atlas) ─────
# Atlas UI → Search → Create Search Index → "default" on `products`,
# mapping name + description as `text` + `name` as `autocomplete`.
SEARCH_ATLAS_ENABLED=true
SEARCH_ATLAS_INDEX=default
SEARCH_PAGE_SIZE=30

# ───── Nightly catalog indexer (full-throttle) ─────
INDEXER_SCHEDULED=true
INDEXER_CRON=0 0 3 * * *
INDEXER_MAX_PRODUCTS_PER_SHOP=500
INDEXER_MAX_URLS_PER_SHOP=1500
INDEXER_PER_HOST_PARALLELISM=3
INDEXER_GLOBAL_PARALLELISM=64
INDEXER_PER_EXTRACT_TIMEOUT_MS=30000
INDEXER_USER_AGENT=Mozilla/5.0 (compatible; DamKemonBot/1.0; +https://damkemon.com/bot)

# ───── HTTP scraper tuning ─────
SCRAPER_TIMEOUT_MS=20000
SCRAPER_RETRIES=2
SCRAPER_RETRY_DELAY=1000
SCRAPER_REQUEST_DELAY=400

# ───── Headless browser (Daraz/Pickaboo etc. need JS rendering) ─────
# First boot downloads Chromium (~150MB) — give the container +500MB disk.
BROWSER_ENABLED=true
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=25000
BROWSER_WAIT_UNTIL=DOMCONTENTLOADED

# ───── Daily snapshots + derived rails ─────
PRICE_HISTORY_ENABLED=true
PRICE_HISTORY_CRON=0 0 4 * * *
HOT_DROPS_CRON=0 0 5 * * *

# ───── Per-IP rate limit ─────
# 120 burst, 2/sec sustained ≈ 120 req/min/IP. Bump if you front-end with a CDN.
RATE_LIMIT_CAPACITY=120
RATE_LIMIT_REFILL_PER_SEC=2.0

# ───── Reusable Lemon Squeezy payments ─────
# Enable only after the API key and matching signed webhook are configured.
PAYMENTS_ENABLED=false
PAYMENTS_FINGERPRINT_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARS
LEMON_SQUEEZY_TEST_API_KEY=REPLACE_WITH_TEST_MODE_API_KEY
LEMON_SQUEEZY_LIVE_API_KEY=
LEMON_SQUEEZY_WEBHOOK_SECRET=REPLACE_WITH_32_TO_40_RANDOM_CHARS
LEMON_SQUEEZY_WEBHOOK_URL=https://damkemon.com/api/payments/v1/webhooks/lemon-squeezy
PAYMENTS_REWIRE_ENABLED=false
PAYMENTS_REWIRE_STORE_ID=445309
PAYMENTS_REWIRE_PRODUCT_ID=1266751
PAYMENTS_REWIRE_VARIANT_ID=1980706
PAYMENTS_REWIRE_TEST_MODE=true
PAYMENTS_REWIRE_REDIRECT_URL=https://damkemon.com/payment/complete
RATE_LIMIT_PAYMENT_CAPACITY=20
RATE_LIMIT_PAYMENT_REFILL_PER_SEC=0.20
